# Rendered by the darkfall role. The topology mirrors OGDarkfall's
# docker/docker-compose.yml, but the nodes share one image and bind-mount their
# binary, jars and config from the stage dir rather than baking them in with
# Dockerfile.node. Shipping a build is then an rsync plus a restart, where an
# image build would recreate every container and force a cold cluster boot.
name: darkfall-server

x-logging: &default-logging
  driver: json-file
  options:
    max-size: "10m"
    max-file: "3"

x-log-volume: &log-volume {{ darkfall_log_dir }}:/var/log/darkfall

x-node-common: &node-common
  restart: unless-stopped
  logging: *default-logging
  depends_on:
    darkfall-pg:
      condition: service_healthy
  networks:
    - darkfall

services:
  darkfall-pg:
    image: {{ darkfall_postgres_image }}
    logging: *default-logging
    cpus: "1.0"
    environment:
      POSTGRES_USER: {{ darkfall_db_user }}
      POSTGRES_PASSWORD: {{ darkfall_db_password }}
      POSTGRES_DB: {{ darkfall_db_name }}
    # The node logs record the packed SQLSTATE, not the message; the failing
    # statement is only ever in the Postgres log.
    command:
      - postgres
      - -c
      - logging_collector=on
      - -c
      - log_directory=/var/log/darkfall
      - -c
      - log_filename=postgres.log
      - -c
      - log_rotation_size=0
      - -c
      - log_rotation_age=0
      - -c
      - log_min_error_statement=error
      - -c
      - log_min_messages=warning
    volumes:
      - darkfall-pg-data:/var/lib/postgresql/data
      # Generated by `gradlew generatePostgresSchema`; initdb runs it on first boot only.
      - {{ darkfall_stage_dir }}/deploy/pg:/docker-entrypoint-initdb.d:ro
      - *log-volume
    # Loopback only: the schema is reachable over the VPN by way of ssh, not the LAN.
    ports:
      - "127.0.0.1:{{ darkfall_db_port }}:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ darkfall_db_user }} -d {{ darkfall_db_name }}"]
      interval: 5s
      timeout: 5s
      retries: 20
    networks:
      - darkfall

{% for node in darkfall_nodes %}
  {{ node.name }}:
    <<: *node-common
    image: {{ darkfall_base_image }}:{{ darkfall_base_tag }}
    cpus: "{{ node.cpus }}"
    mem_limit: {{ node.memory }}
    environment: { SF_NODE: {{ node.name }} }
    # The entrypoint is mounted, not baked, so editing it needs no image build.
    entrypoint: ["/bin/bash", "/opt/darkfall/node-entrypoint.sh"]
    volumes:
      - {{ darkfall_stage_dir }}/Build/Server-linux/{{ node.name }}:/opt/darkfall/bin/{{ node.name }}:ro
      - {{ darkfall_stage_dir }}/docker/configs/{{ node.name }}:/opt/darkfall/config:ro
{% for mount in darkfall_node_mounts %}
      - {{ mount }}
{% endfor %}
      - *log-volume
{% if node.name == 'frontend' %}
    ports:
      - "{{ darkfall_client_port }}:21000"
      - "{{ darkfall_server_port }}:10001"
      - "{{ darkfall_admin_port }}:1111"
{% endif %}

{% endfor %}
  # The cluster boots all-or-nothing and a lone restarted node trips a
  # reconnect-crash bug in its peers, so the whole game group restarts together.
  mgmt:
    image: {{ darkfall_watchdog_image }}
    restart: unless-stopped
    logging: *default-logging
    environment:
      COMPOSE_PROJECT: darkfall-server
      WATCH_SERVICES: "{{ darkfall_nodes | map(attribute='name') | join(' ') }}"
      POLL_INTERVAL: "5"
      STARTUP_GRACE: "{{ darkfall_startup_grace }}"
      MAX_RESTARTS: "5"
      RESTART_WINDOW: "600"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - {{ darkfall_stage_dir }}/docker/mgmt-watchdog.sh:/opt/mgmt-watchdog.sh:ro
      - *log-volume
    entrypoint: ["/bin/sh", "/opt/mgmt-watchdog.sh"]

  # Status page. Joins the darkfall network so it can probe the frontend's
  # listener, and reads the log dir and the docker socket read-only -- it has no
  # way to act on the cluster, only to report on it.
  status:
    image: {{ darkfall_status_image }}
    restart: unless-stopped
    logging: *default-logging
    environment:
      DF_NODES: "{{ darkfall_nodes | map(attribute='name') | join(' ') }}"
      DF_PROJECT: darkfall-server
      DF_CLIENT_PORT: "{{ darkfall_client_port }}"
      DF_PORT: "{{ darkfall_status_port }}"
      DF_DB_USER: {{ darkfall_db_user }}
      DF_DB_NAME: {{ darkfall_db_name }}
      # Shown to players on the public page so they know where to point a client.
      DF_SERVER_ADDRESS: "{{ darkfall_ip }}:{{ darkfall_client_port }}"
    volumes:
      - {{ darkfall_stage_dir }}/status_server.py:/opt/status_server.py:ro
      - {{ darkfall_log_dir }}:/var/log/darkfall:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
    ports:
      - "{{ darkfall_status_port }}:{{ darkfall_status_port }}"
    command: ["python3", "/opt/status_server.py"]
    networks:
      - darkfall

networks:
  darkfall:
    driver: bridge
    ipam:
      config:
        # Pinned so the UDP discovery broadcast address is the one baked into
        # every node config by assemble-configs.sh.
        - subnet: {{ darkfall_subnet }}

volumes:
  darkfall-pg-data:
