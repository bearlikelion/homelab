# Rendered by the build_runner role.
#
# The runner uses the host Docker daemon to start a fresh container per job,
# which is root-equivalent on this box. That is why Forgejo itself lives in the
# code container and not here.
name: build-runner

x-logging: &default-logging
  driver: json-file
  options:
    max-size: "10m"
    max-file: "3"

services:
  runner:
    image: {{ build_runner_image }}
    restart: unless-stopped
    command: forgejo-runner daemon --config /data/config.yaml
    # The image runs as 1000:1000, which cannot open the Docker socket.
    user: "0:0"
    environment:
      DOCKER_HOST: unix:///var/run/docker.sock
    extra_hosts:
{% for alias in build_runner_host_aliases %}
      - "{{ alias }}"
{% endfor %}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - {{ build_runner_dir }}/runner:/data
      - {{ build_runner_dir }}/cache:/cache
      # Caddy's root, installed on the host above, so the daemon trusts the
      # instance it polls.
      - /etc/ssl/certs:/etc/ssl/certs:ro
    logging: *default-logging
