# The *arr stack and download client.
#
# Every service that touches media mounts the SAME /data volume, so
# /data/torrents and /data/movies are one filesystem inside the container and
# imports can hardlink. Mounting them separately would make radarr/sonarr fall
# back to a slow full copy, silently.

services:
  qbittorrent:
    image: {{ qbittorrent_image }}
    container_name: qbittorrent
    restart: unless-stopped
    environment:
      - PUID={{ media_uid }}
      - PGID={{ media_gid }}
      - TZ={{ timezone }}
      # 002 so group members can manage each other's files. The default 022
      # leaves files non-group-writable and breaks *arr imports.
      - UMASK=002
      - WEBUI_PORT={{ qbittorrent_port }}
      - TORRENTING_PORT={{ qbittorrent_torrent_port }}
    volumes:
      - {{ stack_dir }}/qbittorrent:/config
      - /data:/data
    ports:
      # Web UI stays on the LAN; only the torrent port is meant to be forwarded.
      - "{{ qbittorrent_port }}:{{ qbittorrent_port }}"
      - "{{ qbittorrent_torrent_port }}:{{ qbittorrent_torrent_port }}"
      - "{{ qbittorrent_torrent_port }}:{{ qbittorrent_torrent_port }}/udp"

  prowlarr:
    image: {{ prowlarr_image }}
    container_name: prowlarr
    restart: unless-stopped
    environment:
      - PUID={{ media_uid }}
      - PGID={{ media_gid }}
      - TZ={{ timezone }}
      - UMASK=002
    volumes:
      - {{ stack_dir }}/prowlarr:/config
    ports:
      - "{{ prowlarr_port }}:9696"

  radarr:
    image: {{ radarr_image }}
    container_name: radarr
    restart: unless-stopped
    environment:
      - PUID={{ media_uid }}
      - PGID={{ media_gid }}
      - TZ={{ timezone }}
      - UMASK=002
    volumes:
      - {{ stack_dir }}/radarr:/config
      - /data:/data
    ports:
      - "{{ radarr_port }}:7878"

  sonarr:
    image: {{ sonarr_image }}
    container_name: sonarr
    restart: unless-stopped
    environment:
      - PUID={{ media_uid }}
      - PGID={{ media_gid }}
      - TZ={{ timezone }}
      - UMASK=002
    volumes:
      - {{ stack_dir }}/sonarr:/config
      - /data:/data
    ports:
      - "{{ sonarr_port }}:8989"

  tautulli:
    image: {{ tautulli_image }}
    container_name: tautulli
    restart: unless-stopped
    environment:
      - PUID={{ media_uid }}
      - PGID={{ media_gid }}
      - TZ={{ timezone }}
    volumes:
      - {{ stack_dir }}/tautulli:/config
    ports:
      - "{{ tautulli_port }}:8181"

  maintainerr:
    image: {{ maintainerr_image }}
    container_name: maintainerr
    restart: unless-stopped
    user: "{{ media_uid }}:{{ media_gid }}"
    environment:
      - TZ={{ timezone }}
    volumes:
      - {{ stack_dir }}/maintainerr:/opt/data
    ports:
      - "{{ maintainerr_port }}:6246"
